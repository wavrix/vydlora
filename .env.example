# Vydlora automatically starts the bundled Lora 1 engine when it is not running.
LORA1_ENGINE_URL=http://127.0.0.1:8000
LORA1_DATA_DIR=.runtime/lora1
LORA1_MANAGE_ENGINE=1
# Optional token when connecting to a separately managed engine.
# Managed engines get a random token held in the server's memory.
LORA1_AUTH_TOKEN=
PORT=5173
